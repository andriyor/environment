{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "life-notes/template",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "folder",
  "auto_jump_to_cursor": false,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "folder_templates": [
    {
      "folder": "/",
      "template": "life-notes/template/init.md"
    }
  ],
  "file_templates": [],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [
    {
      "template": "life-notes/template/github-activity.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "life-notes/template/toggl-activity.md",
      "insert_enabled": true,
      "create_enabled": false
    }
  ],
  "startup_templates": [
    "life-notes/template/auto-done-date.md"
  ],
  "intellisense_render": "1",
  "ignore_folders_on_creation": []
}