// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "disable_ai": false,
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git": {
    "diff_base": "default_branch"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "terminal": {
    "starts_open": true,
    "font_family": "JetBrainsMono Nerd Font Mono" // starship icons; Ghostty bundles them, Zed doesn't
  },
  "edit_predictions": {
    "provider": "none" // Zed AI predictions off; agent work goes through claude CLI below
  },
  "agent": {
    "dock": "right",
    "terminal_init_command": "claude" // Terminal Threads run the installed Claude Code CLI
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry" // Claude Agent from the ACP registry; billed to the Claude login, not Zed
    }
  },
  "ssh_connections": [
    {
      "host": "rp",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/aoriekhov"
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "Catppuccin Mocha - No Italics"
  },
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": false,
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Frappé"
  },
  "tabs": {
    "file_icons": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "tab_size": 2
}
