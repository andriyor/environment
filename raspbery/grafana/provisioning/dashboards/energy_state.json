      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-ha" },
          "query": "prev = from(bucket: \"homeassistant\")\n  |> range(start: -30d, stop: v.timeRangeStart)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"input_select.energy_state\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state\")\n  |> last()\n  |> map(fn: (r) => ({r with _time: v.timeRangeStart}))\n  |> group()\n\ncurrent = from(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"input_select.energy_state\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state\")\n  |> aggregateWindow(every: 1m, fn: last, createEmpty: true)\n  |> group()\n\nunion(tables: [prev, current])\n  |> sort(columns: [\"_time\"])\n  |> fill(usePrevious: true)\n  |> filter(fn: (r) => exists r._value)\n  |> filter(fn: (r) => r._time > v.timeRangeStart)\n  |> map(fn: (r) => ({_time: r._time, _value: 1.0 / 60.0, state: r._value}))\n  |> group(columns: [\"state\"])\n  |> sum(column: \"_value\")\n  |> map(fn: (r) => ({_time: now(), _field: r.state, _value: r._value, _measurement: \"hours\"}))\n  |> group(columns: [\"_field\", \"_measurement\"])",
          "refId": "A"
        }
      ],
      "title": "Energy — Time Spent per State",
      "type": "stat"
    },
